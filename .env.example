# Credentials for the probe scripts under tools/.
#
#   cp .env.example .env      then fill in the values
#
# .env is git-ignored and must stay that way: it holds a real password for a real server.
# This template is committed; the file it produces never is.
#
# Real environment variables take precedence over this file, so a single probe can be pointed
# somewhere else for one run without editing anything:
#
#   JELLYFIN_URL=http://other-server:8096 python3 tools/probe_query_envelope.py
#
# Every probe reads these. None of them logs a password, at any level.

# The reference server to measure. Must be a Jellyfin 10.11.x — the probes refuse to run against
# anything whose ProductName is not Jellyfin, because measuring something else measures nothing.
JELLYFIN_URL=http://your-jellyfin:8096

# A user to authenticate as. An ordinary account is enough for the read-only probes; the ones
# that write need permission to create and delete playlists.
JELLYFIN_USERNAME=

# Leave empty to be prompted instead of storing it. The prompt is the safer default and costs
# one line of typing per run.
JELLYFIN_PASSWORD=

# An existing access token, as an alternative to username and password. When set, it wins and
# no authentication request is made.
JELLYFIN_TOKEN=

# An account that is DISABLED on the reference, for probe_auth_mechanisms.py. Measuring how the
# server refuses a disabled user is 002 OQ-3, and it cannot be measured without one. Make an
# account nobody uses, disable it, and name it here. Leave it empty and that one question goes
# unanswered rather than guessed - a guess means failed logins against somebody else's account.
#
# No probe ever tests lockout deliberately: failing N logins locks a real account, and the counter
# it moves is not one a probe can reset.
JELLYFIN_DISABLED_USERNAME=
JELLYFIN_DISABLED_PASSWORD=

# The server under test, for tools/differential.py alone. Every probe measures the reference and
# needs no account here; the differential authenticates against BOTH servers, because a seat is an
# account and the two do not share one — the restricted reader it creates for the run is created
# on each side and destroyed on each side.
#
# Its URL is --atrium, which docs/compatibility/conformance.md publishes; only the credentials
# come from here. A token wins over a username and password, as above.
ATRIUM_USERNAME=
ATRIUM_PASSWORD=
ATRIUM_TOKEN=
